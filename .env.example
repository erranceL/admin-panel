# API 环境地址（每套环境多个地址互为备用，默认用第一个）
# SIT  : https://surfv2-sit-api.nfexinsider.com
# UAT  : https://surfv2-uat-api.nfexinsider.com
#        备用 https://betav2-api.surf.one / https://betav2-api2.surf.one
# PROD : https://api.turboflow.xyz
#        备用 https://api2.turboflow.xyz / https://api3.turboflow.xyz / https://api4.turboflow.xyz
# 当前默认连接 SIT，切换环境时改下面这一行即可。
VITE_API_BASE_URL=https://surfv2-sit-api.nfexinsider.com
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_PUBLIC_BASE_PATH=/admin-panel/
VITE_API_TIMEOUT_MS=10000
VITE_ENABLE_ADMIN_WRITES=true
VITE_ALLOW_MOCK_RECHARGE=true
VITE_DEV_AUTH_TOKEN=
